 ],
 "unassigned_microlocation": "Unassigned",
 "description": "Citimon hierarchy: Citimon -> recorder (location) -> microlocation (exact coordinates). Source folders are internal metadata; dates come from recording timestamps.",
 "decisions": {
  "2026-11-05": [
   "R35 -> C35 folder move intentional",
   "C19-1 -> 2026_03-C19, C19-2 -> 2026_04-C19; one recorder, one microlocation",
   "no coordinates -> accepted_unassigned, no microlocation, no map marker",
   "C47 keeps two microlocations",
   "numbering by earliest folder prefix over full catalogue, then frozen",
   "canonical path config/citimon_registry.json"
  ],
  "2026-11-10": [
   "2026_03-R35, 2026-06-C35 and 2026_02-C49 excluded from ingestion as duplicates; names stay resolvable",
   "C19 rename approved: 2026_03-C19 and 2026_04-C19 -> C19-P1"
  ]
 },
 "id_policy": {
  "recorder": "Uppercase recorder prefix + number from the folder name (original spelling kept in recorder_original/aliases).",
  "microlocation": "<recorder>-P<n>. Identity = recorder + exact numeric latitude/longitude from the coordinate source (no rounding). Initial n assigned within each recorder by earliest folder label, then latitude, longitude, over the full catalogue. After approval IDs are frozen: never renumbered or reused; a new position takes the next free n; a returning position reuses its ID.",
  "missing_coordinates": "No microlocation is assigned; entry is flagged for review.",
  "frozen": "On every regeneration, IDs already present in the previously approved registry are carried over unchanged; only positions not yet in the ledger receive next_free."
 },
